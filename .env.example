# Flyby configuration — copy to `.env` and edit. One file for both the API and the web app.
# On Render, set these under the service's "Environment" tab instead (they override .env).

# ---------------------------------------------------------------- ports
# Public port of the app (the Next.js web server). Render sets this automatically.
PORT=3000
# Internal port of the NestJS API. Only the web app talks to it (via /api/*).
API_PORT=4000

# ---------------------------------------------------------------- map tiles
# Optional CARTO basemaps key (free: https://carto.com/basemaps/apikey/).
# When set, the Dark and Light map styles use CARTO tiles; otherwise Esri tiles are used.
# Note: a wrong key isn't reported as an error — tiles just show an "API KEY REQUIRED" watermark.
CARTO_API_KEY=

# ---------------------------------------------------------------- OpenSky (optional, free account)
# Without credentials OpenSky allows a small anonymous quota per IP per day. A free account
# (email only) raises it a lot: OpenSky website → Account → "API client" → download credentials.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Gap filling: where adsb.lol/adsb.fi return only a few aircraft (thin coverage), also ask
# OpenSky and merge. "auto" = on when credentials are set; "true"/"false" to force.
OPENSKY_FILL=auto
# Daily cap on gap-filling requests (each area is cached 60 s), to protect the quota.
OPENSKY_FILL_MAX_PER_DAY=1500
# Keyless "estimated position" for out-of-coverage flights uses OpenSky's recent-flights list,
# refreshed every 20 min. Set to false to turn that index off.
OPENSKY_FLIGHTS_INDEX=true

# ---------------------------------------------------------------- estimated aircraft layer
# Flights that recently went silent (left receiver coverage) are shown as dashed "estimated"
# planes, moved along their route. Stop estimating after this many minutes without a signal.
ESTIMATE_MAX_MINUTES=90

# ---------------------------------------------------------------- flight status (optional)
# FlightAware AeroAPI key — adds schedules, delays, gates and *estimated positions* for flights
# no free receiver can hear (oceans, remote regions). Free "Personal" tier: $5/month of queries
# (sign up at https://www.flightaware.com/aeroapi/portal). Leave empty to disable.
FLIGHTAWARE_AEROAPI_KEY=
# Hard cap on AeroAPI calls per day, to stay inside the free monthly credit.
# Each call is cached for 5 min, so 30/day is plenty for personal use.
AEROAPI_MAX_CALLS_PER_DAY=30
# Departure boards for major airports no receiver covers (e.g. Colombo), so their departing
# flights appear on the estimated layer without being searched. Fetched only while someone
# views that area; separate daily cap. Set the cap to 0 to disable.
AEROAPI_BOARD_CALLS_PER_DAY=24
AEROAPI_BOARD_REFRESH_MIN=60
# Include flights heading INTO those airports (one more request per refresh).
AEROAPI_BOARD_ARRIVALS=true
# Area search: airborne flights FlightAware positions in a viewport the free networks barely
# cover (incl. overflights nobody searched). Cached per area; separate daily cap; 0 disables.
AEROAPI_AREA_CALLS_PER_DAY=24
AEROAPI_AREA_REFRESH_MIN=10
# FlightAware live position for starred flights and the no-signal panel, used only while the
# flight is airborne and no free network hears it. Reused for REFRESH_SEC. Cap 0 disables.
AEROAPI_POSITION_CALLS_PER_DAY=200
AEROAPI_POSITION_REFRESH_SEC=60
# "At the airport" tab: recently landed + departing-soon lists with gates (2 requests per
# airport, only when the tab is opened). Separate daily cap; 0 disables.
AEROAPI_GROUND_CALLS_PER_DAY=24
AEROAPI_GROUND_REFRESH_MIN=15

# ---------------------------------------------------------------- live data sources
# Add airplanes.live to the live-data failover chain (adsb.lol → adsb.fi → airplanes.live → OpenSky).
# airplanes.live blocks unapproved apps (HTTP 403) — ask contact@airplanes.live first, then set true.
AIRPLANES_LIVE_ENABLED=false
# Optional explicit order of the readsb feeds (overrides the above; OpenSky is always last):
# ADSB_PROVIDERS=adsblol,adsbfi,airplaneslive

# Whole-network / box endpoint used for map viewports (one request per view). Empty = disable.
LIVE_BULK_URL=https://re-api.adsb.lol/
# How long live position responses are reused (ms) — keeps us inside free rate limits.
LIVE_CACHE_MS=5000
# Minimum gap between requests to adsb.lol (ms).
ADSBLOL_MIN_INTERVAL_MS=400

# ---------------------------------------------------------------- misc
# Refresh the airport database from OurAirports at boot + weekly (a bundled copy is always available).
AIRPORTS_REFRESH=true
# User-Agent sent to upstream APIs (Planespotters requires a descriptive one).
UPSTREAM_USER_AGENT=Flyby/1.0 (+https://github.com/hellixit/flyby; flight tracker)
# Allowed origins for calling the API directly from a browser ("*" = any).
CORS_ORIGINS=*

# Advanced: run the API elsewhere instead of in-process. Normally leave unset.
# BACKEND_URL=https://my-flyby-api.example.com
# BACKEND_FALLBACK_URLS=https://replica-2.example.com
